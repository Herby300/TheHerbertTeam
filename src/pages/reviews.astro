---
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import GoogleReviews from '../components/ui/GoogleReviews.astro';
import { testimonialDisclaimer } from '../data/testimonials';
import { breadcrumbSchema } from '../utils/seo';
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Reviews', href: '/reviews' }];
---
<PageLayout title="Google Reviews" description="Read live Google reviews for The Herbert Team and Jason Herbert. See client feedback in one unfiltered feed, directly from Google."
  heroEyebrow="Client Feedback" heroTitle="Hear From Our Clients." heroSubtitle="Live reviews from Google, together in one unfiltered feed."
  heroImage="/images/hero/about-hero.webp" heroImageAlt="The Herbert Team client reviews" crumbs={crumbs} schema={breadcrumbSchema(crumbs)}>
  <Section bg="offwhite">
    <SectionHeading eyebrow="Live From Google" title="Unfiltered Google Reviews" subtitle="Read what clients have shared about working with The Herbert Team, directly from Google." align="center" class="mb-10" />
    <div class="rounded-card border border-silver-light bg-white p-4 shadow-card md:p-8"><GoogleReviews minHeight="700px" /></div>
    <p class="mx-auto mt-8 max-w-3xl text-center text-sm text-graytext">{testimonialDisclaimer}</p>
  </Section>
</PageLayout>
