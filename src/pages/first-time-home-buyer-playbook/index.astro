---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Container from '../../components/Container.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PlaybookLeadForm from '../../components/forms/PlaybookLeadForm.astro';
import Icon from '../../components/ui/Icon.astro';
import Button from '../../components/Button.astro';
import { playbook, site } from '../../data/site';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'First-Time Home Buyer’s Playbook', href: playbook.href },
];

const learnItems = [
  'How preapproval actually works',
  'How much house you can qualify for vs. how much you should spend',
  'Credit, debt-to-income ratio, and what lenders review',
  'Down payment, closing costs, prepaids, and cash to close',
  'Loan-program strategy and how to choose the right mortgage solution',
  'What to do after your offer is accepted',
  'Inspection vs. appraisal',
  'What NOT to do after you’re preapproved',
  'What happens at closing',
  'What to expect after you get the keys',
];

const pageTitle = 'First-Time Home Buyer’s Playbook';
const pageDescription =
  'Download The Herbert Team’s free First-Time Home Buyer’s Playbook — preapproval, down payments, closing costs, credit, inspections, and the mortgage process.';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={playbook.coverImage}
  imageWidth={playbook.coverImageWidth}
  imageHeight={playbook.coverImageHeight}
>
  <section class="relative isolate bg-navy">
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <div class="absolute inset-0 bg-gradient-to-br from-navy-light via-navy to-navy-dark"></div>
      <div class="absolute -right-24 top-1/3 h-[28rem] w-[28rem] rounded-full bg-brandblue/20 blur-3xl"></div>
    </div>

    <Container class="relative pb-14 pt-8 md:pb-20 md:pt-10">
      <Breadcrumbs crumbs={crumbs} invert />
      <div class="mt-8 grid items-start gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-14">
        <div>
          <p class="text-eyebrow font-heading font-semibold uppercase text-gold">Free Download</p>
          <h1 class="mt-4 font-heading text-display text-white">Download the First-Time Home Buyer&rsquo;s Playbook</h1>
          <p class="mt-6 max-w-2xl text-body-lg text-silver-light">
            A practical guide to help you understand the mortgage process, know your numbers, avoid costly mistakes, and
            buy your first home with confidence.
          </p>
          <ul class="mt-8 space-y-3">
            {
              ['Plain-English process map', 'Real numbers before you tour', 'Mistakes that cost buyers money'].map(
                (item) => (
                  <li class="flex items-start gap-3 text-silver-light">
                    <Icon name="check-circle" size={20} class="mt-0.5 shrink-0 text-brandblue" />
                    <span>{item}</span>
                  </li>
                )
              )
            }
          </ul>
        </div>

        <div class="mx-auto w-full max-w-sm lg:mx-0 lg:justify-self-end">
          <div class="relative overflow-visible">
            <div class="pointer-events-none absolute -inset-3 -z-10 rounded-card bg-brandblue/20 blur-xl" aria-hidden="true"></div>
            <img
              src={playbook.coverImage}
              srcset={[
                '/images/lead-magnets/first-time-home-buyer-playbook-cover-360w.webp 360w',
                '/images/lead-magnets/first-time-home-buyer-playbook-cover-540w.webp 540w',
                '/images/lead-magnets/first-time-home-buyer-playbook-cover-720w.webp 720w',
                `${playbook.coverImage} 900w`,
              ].join(', ')}
              sizes="(max-width: 1024px) min(100vw - 2rem, 24rem), 22rem"
              alt={playbook.coverImageAlt}
              width={playbook.coverImageWidth}
              height={playbook.coverImageHeight}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="relative mx-auto block h-auto w-full rounded-card border border-white/20 object-contain object-center shadow-card-hover"
            />
          </div>
        </div>
      </div>
    </Container>
  </section>

  <Section bg="offwhite" id="get-playbook">
    <div class="grid items-start gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:gap-14">
      <div>
        <SectionHeading
          eyebrow="Get Your Copy"
          title="Tell Me Where to Send It"
          subtitle="Fill this out and I&rsquo;ll send you straight to the Playbook download. No spam — just a useful guide and a real person if you want help next."
          align="left"
          class="mb-8"
        />
        <div class="rounded-card border border-silver-light bg-white p-5 shadow-card md:p-7">
          <PlaybookLeadForm />
        </div>
      </div>

      <div>
        <SectionHeading
          eyebrow="Inside the Playbook"
          title="What You’ll Learn"
          align="left"
          class="mb-8"
        />
        <ul class="space-y-3.5">
          {
            learnItems.map((item) => (
              <li class="flex items-start gap-3 rounded-lg border border-silver-light bg-white px-4 py-3.5 shadow-sm">
                <Icon name="check" size={18} class="mt-0.5 shrink-0 text-success" />
                <span class="text-[0.9375rem] leading-relaxed text-charcoal">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <Section bg="white">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-eyebrow font-heading font-semibold uppercase text-brandblue">{site.positioning}</p>
      <h2 class="mt-4 text-h2 text-navy">{site.tagline}</h2>
      <p class="mt-6 text-body-lg text-graytext">
        Most lenders start with a rate sheet. {site.advisor} starts with your goals, your numbers, and your real
        situation — then builds a mortgage strategy that fits. The Playbook is the same approach in writing: clear
        explanations, practical checklists, and the questions worth asking before you commit.
      </p>
      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <Button href="/schedule" variant="primary" size="lg" icon="arrow-right" track="schedule">
          Book a Free Strategy Call
        </Button>
        <Button href="/solutions/first-time-homebuyers" variant="secondary" size="lg">
          First-Time Buyer Solutions
        </Button>
      </div>
    </div>
  </Section>
</Layout>

<script>
  import { track } from '../../utils/tracking';
  track('playbook_landing_view', { source_page: '/first-time-home-buyer-playbook' });
</script>
