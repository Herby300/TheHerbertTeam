---
/**
 * Loads Pivot Point / GHL form_embed.js once per page when handshake-aware
 * embeds (booking widgets, non-plain forms) are present.
 */
---

<script is:inline>
  (function (d, id, src) {
    if (d.getElementById(id)) return;
    var s = d.createElement('script');
    s.id = id;
    s.src = src;
    s.async = true;
    d.body.appendChild(s);
  })(document, 'ghl-form-embed', 'https://link.pivotpointcrm.com/js/form_embed.js');
</script>
