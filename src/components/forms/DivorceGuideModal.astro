---
import { divorceGuide, formBase } from '../../data/site';
const formUrl = `${formBase}${divorceGuide.formId}`;
---

<dialog id="divorce-guide-modal" aria-labelledby="divorce-guide-title" aria-describedby="divorce-guide-description">
  <div class="guide-modal-header">
    <h2 id="divorce-guide-title" class="font-heading text-h3 text-navy">Get Your Free Divorce &amp; Mortgage Guide</h2>
    <button type="button" class="guide-modal-close" aria-label="Close guide form" autofocus>&times;</button>
  </div>
  <div class="guide-modal-body">
    <p id="divorce-guide-description" class="mb-5 text-graytext">Enter your name, email, and phone number to request your copy.</p>
    <div data-ghl-active="divorce_guide">
      <iframe data-src={formUrl} title="Divorce & Mortgage Guide request form" class="guide-modal-frame"></iframe>
    </div>
    <p class="mt-4 text-sm text-graytext">
      Having trouble viewing the form?
      <a href={formUrl} target="_blank" rel="noopener noreferrer" class="underline">Open the form in a new tab</a>.
    </p>
    <p class="mt-3 text-xs text-graytext">
      No cost or obligation.
      <a href="https://www.planethomelending.com/privacy-policy" target="_blank" rel="noopener noreferrer" class="underline">Privacy Policy</a>
    </p>
  </div>
</dialog>

<style>
  dialog { width: min(42rem, calc(100% - 1.5rem)); max-height: 90vh; max-height: 90dvh; margin: auto; padding: 0; border: 0; border-radius: 1rem; background: white; box-shadow: 0 24px 80px #0005; }
  dialog::backdrop { background: rgb(10 25 45 / 75%); }
  .guide-modal-header { position: sticky; top: 0; z-index: 1; display: flex; align-items: flex-start; gap: 1rem; padding: 1.25rem; background: white; border-bottom: 1px solid #e5e7eb; }
  .guide-modal-close { flex-shrink: 0; margin-left: auto; width: 44px; height: 44px; border-radius: .5rem; font-size: 2rem; line-height: 1; color: #14283f; }
  .guide-modal-close:hover { background: #f1f5f9; }
  .guide-modal-close:focus-visible { outline: 2px solid #2563eb; outline-offset: 2px; }
  .guide-modal-body { padding: 1.25rem; }
  .guide-modal-frame { display: block; width: 100%; height: 760px; border: 0; border-radius: .75rem; }
  @media (max-width: 480px) { .guide-modal-header, .guide-modal-body { padding: 1rem; } }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#divorce-guide-modal');
  const frame = dialog?.querySelector<HTMLIFrameElement>('iframe');
  let opener: HTMLElement | null = null;
  let previousOverflow = '';

  if (dialog && frame) {
    // The real form URL remains a working fallback when JavaScript is unavailable.
    document.querySelectorAll<HTMLAnchorElement>('a.divorce-guide-trigger').forEach((trigger) => {
      trigger.setAttribute('aria-haspopup', 'dialog');
      trigger.setAttribute('aria-controls', dialog.id);
      trigger.addEventListener('click', (event) => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        opener = trigger;
        if (!frame.hasAttribute('src') && frame.dataset.src) frame.src = frame.dataset.src;
        previousOverflow = document.body.style.overflow;
        dialog.showModal();
        document.body.style.overflow = 'hidden';
      });
    });
    dialog.querySelector<HTMLButtonElement>('.guide-modal-close')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target !== dialog) return;
      const bounds = dialog.getBoundingClientRect();
      if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
    });
    dialog.addEventListener('close', () => {
      document.body.style.overflow = previousOverflow;
      opener?.focus();
    });
    // Download delivery is controlled by the CRM's successful-submission redirect.
    // Never unlock the PDF on an iframe load or an unverified postMessage.
  }
</script>
