---
import { site } from '../../data/site';

interface Props {
  class?: string;
  minHeight?: string;
}

const { class: className = '', minHeight = '420px' } = Astro.props;
---

<section
  class={`google-reviews-embed ${className}`}
  style={`min-height:${minHeight}`}
  aria-label="Google Reviews for The Herbert Team"
>
  <div class={`elfsight-app-${site.elfsightReviewsAppId}`} data-elfsight-app-lazy></div>
</section>

{/*
  Load Elfsight only when this reviews region approaches the viewport.
  Script id guard prevents duplicate loads if multiple instances mount.
*/}
<script is:inline>
  (function () {
    var SCRIPT_ID = 'elfsight-platform';
    var SRC = 'https://elfsightcdn.com/platform.js';

    function loadElfsight() {
      if (document.getElementById(SCRIPT_ID)) return;
      var js = document.createElement('script');
      js.id = SCRIPT_ID;
      js.src = SRC;
      js.async = true;
      document.head.appendChild(js);
    }

    var roots = document.querySelectorAll('.google-reviews-embed');
    if (!roots.length) return;

    if (!('IntersectionObserver' in window)) {
      loadElfsight();
      return;
    }

    var observer = new IntersectionObserver(
      function (entries) {
        for (var i = 0; i < entries.length; i++) {
          if (!entries[i].isIntersecting) continue;
          loadElfsight();
          observer.disconnect();
          break;
        }
      },
      { rootMargin: '200px 0px', threshold: 0.01 }
    );

    roots.forEach(function (el) {
      observer.observe(el);
    });
  })();
</script>
