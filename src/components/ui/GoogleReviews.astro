---
import { site } from '../../data/site';

interface Props {
  class?: string;
  minHeight?: string;
}

const { class: className = '', minHeight = '420px' } = Astro.props;
---

<div
  class={`google-reviews-embed ${className}`}
  style={`min-height:${minHeight}`}
  aria-label="Google Reviews for The Herbert Team"
>
  <div class="embedsocial-hashtag" data-ref={site.googleReviewsWidgetId}>
    <a
      class="feed-powered-by-es feed-powered-by-es-feed-img es-widget-branding"
      href="https://embedsocial.com/"
      target="_blank"
      rel="noopener noreferrer"
      title="Widget by EmbedSocial"
    >
      <img src="https://embedsocial.com/cdn/icon/embedsocial-logo.webp" alt="EmbedSocial" width="20" height="20" />
      <div class="es-widget-branding-text">Widget by EmbedSocial</div>
    </a>
  </div>
</div>

{/*
  Load EmbedSocial only on pages that render this component. The script id guard
  matches EmbedSocial's own snippet so a second instance on the same page is a no-op.
*/}
<script is:inline>
  (function (d, s, id) {
    var js;
    if (d.getElementById(id)) {
      return;
    }
    js = d.createElement(s);
    js.id = id;
    js.src = 'https://embedsocial.com/cdn/ht.js';
    d.getElementsByTagName('head')[0].appendChild(js);
  })(document, 'script', 'EmbedSocialHashtagScript');
</script>

<style>
  .google-reviews-embed {
    width: 100%;
    max-width: 100%;
    overflow: visible;
  }

  .google-reviews-embed :global(.embedsocial-hashtag) {
    width: 100%;
    max-width: 100%;
    overflow: visible;
  }
</style>
