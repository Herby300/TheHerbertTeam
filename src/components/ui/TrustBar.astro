---
import Icon from './Icon.astro';
import { site } from '../../data/site';

interface Props {
  invert?: boolean;
  class?: string;
}

const { invert = true, class: className = '' } = Astro.props;

const items = [
  { icon: 'shield-check', label: site.nmls },
  { icon: 'landmark', label: site.institution },
  { icon: 'home', label: 'Equal Housing Lender' },
  { icon: 'award', label: '20+ Years' },
];
---

<ul
  class:list={[
    'flex flex-wrap items-center gap-x-6 gap-y-3 text-sm',
    invert ? 'text-silver-light' : 'text-graytext',
    className,
  ]}
>
  <li class="flex items-center gap-2">

    <a href="/reviews" class={invert ? 'text-white underline underline-offset-2' : 'text-navy underline underline-offset-2'}>Google Reviews</a>
  </li>
  {
    items.map((item) => (
      <li class="flex items-center gap-2">
        <Icon name={item.icon} size={16} class="text-brandblue" />
        <span>{item.label}</span>
      </li>
    ))
  }
</ul>
