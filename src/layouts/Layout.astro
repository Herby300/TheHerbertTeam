---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DeferredThirdParty from '../components/DeferredThirdParty.astro';
import { financialServiceSchema } from '../utils/seo';

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Optional OG image dimensions. Omit both to skip inaccurate width/height tags. */
  imageWidth?: number;
  imageHeight?: number;
  canonical?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  schema?: object;
  bodyClass?: string;
}

const {
  title,
  description,
  image,
  imageWidth,
  imageHeight,
  canonical,
  type,
  noindex = false,
  schema,
  bodyClass = '',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={title}
      description={description}
      image={image}
      imageWidth={imageWidth}
      imageHeight={imageHeight}
      canonical={canonical}
      type={type}
      noindex={noindex}
      schema={schema}
    />

    <DeferredThirdParty />

    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/sora-latin.woff2" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(financialServiceSchema)} />
  </head>

  <body class={`font-body text-charcoal bg-white antialiased ${bodyClass}`}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-navy focus:px-5 focus:py-3 focus:font-heading focus:text-white"
      >Skip to content</a
    >

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script>
      // ---------------------------------------------------------- scroll reveal
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealItems = document.querySelectorAll<HTMLElement>('.reveal');

      if (reduceMotion || !('IntersectionObserver' in window)) {
        revealItems.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry, index) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              const stagger = Number(el.dataset.revealDelay ?? index * 60);
              window.setTimeout(() => el.classList.add('is-visible'), stagger);
              observer.unobserve(el);
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.08 }
        );
        revealItems.forEach((el) => observer.observe(el));
      }
    </script>

    <script>
      // ---------------------------------------------------------- tracking
      import { noteUserGesture, track, type TrackEvent } from '../utils/tracking';

      window.herbertTrack = track;

      const sourcePage = window.location.pathname;

      // Capture first so delegated + element-level handlers share one gesture id.
      document.addEventListener('click', () => noteUserGesture(), true);

      document.addEventListener('click', (event) => {
        const target = event.target as HTMLElement | null;
        if (!target) return;

        const tracked = target.closest<HTMLElement>('[data-track]');
        if (tracked) {
          const name = tracked.dataset.track as TrackEvent;
          let params: Record<string, unknown> = { source_page: sourcePage };
          const raw = tracked.dataset.trackParams;
          if (raw) {
            try {
              params = { ...params, ...JSON.parse(raw) };
            } catch {
              /* malformed params must not block the click */
            }
          }

          // Same-tab begin_application: queue Meta/GA4 before navigation unloads the page.
          // Leave _blank (Primis) alone so popup blockers do not swallow window.open.
          const anchor = tracked.closest<HTMLAnchorElement>('a[href]');
          const href = anchor?.getAttribute('href');
          // Treat missing button (some automation / synthetic clicks) as primary left-click.
          const modifiedClick =
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey ||
            (typeof event.button === 'number' && event.button !== 0);
          if (
            name === 'begin_application' &&
            anchor &&
            href &&
            !href.startsWith('#') &&
            !modifiedClick &&
            anchor.target !== '_blank'
          ) {
            event.preventDefault();
            track(name, params);
            window.setTimeout(() => {
              window.location.assign(href);
            }, 120);
            return;
          }

          track(name, params);
          return;
        }

        const link = target.closest<HTMLAnchorElement>('a[href^="tel:"], a[href^="mailto:"]');
        if (link) {
          const isPhone = link.getAttribute('href')?.startsWith('tel:');
          track(isPhone ? 'phone_click' : 'email_click', { source_page: sourcePage });
        }
      });

      // Program and solution pages announce themselves for ViewContent.
      const programMeta = document.querySelector<HTMLElement>('[data-program-name]');
      if (programMeta) {
        track('view_loan_program', {
          program_name: programMeta.dataset.programName,
          program_type: programMeta.dataset.programType,
        });
      }

      // GoHighLevel iframes post a message on submit. The payload shape varies by
      // GHL release, so match loosely and only fire after a real GHL submit signal.
      window.addEventListener('message', (event) => {
        if (event.origin !== 'https://link.pivotpointcrm.com') return;
        const data = event.data as unknown;
        const asString = typeof data === 'string' ? data : JSON.stringify(data ?? '');
        if (/submit|submission|form_submitted|onFormSubmit/i.test(asString)) {
          const formType = document.querySelector<HTMLElement>('[data-ghl-active]')?.dataset.ghlActive;
          if (formType === 'playbook') {
            track('playbook_form_submit', {
              form_type: 'playbook',
              source_page: sourcePage,
              crm_ok: true,
            });
            return;
          }
          track('form_submit', { form_type: formType ?? 'unknown', source_page: sourcePage });
        }
      });
    </script>
  </body>
</html>
